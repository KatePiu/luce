# Copia questo file in ".env" e compila i valori prima di avviare il progetto.
# Vedi README.md per la spiegazione di ogni voce e dove trovarla.

# --- Database (valore di default già corretto per docker-compose) ---
DATABASE_URL=postgresql+psycopg://luce:luce@localhost:5432/luce

# --- Anthropic (genera le risposte del tutor) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Voyage AI (ricerca semantica nei materiali) ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multilingual-2

# --- Trascrizione vocale (STT), endpoint compatibile OpenAI ---
STT_API_KEY=
STT_API_BASE=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- Superchat (WhatsApp) ---
SUPERCHAT_API_KEY=
SUPERCHAT_API_BASE=https://api.superchat.com/v1.0
SUPERCHAT_WEBHOOK_SECRET=
SUPERCHAT_CHANNEL_ID=
SUPERCHAT_HUMAN_AGENT_USER_ID=

# --- Autenticazione ---
JWT_SECRET=cambia-questo-valore-con-una-stringa-lunga-e-casuale

# --- Escalation verso il tutor umano ---
HUMAN_TUTOR_EMAIL=nicola.ratti@katepiu.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=luce@katepiu.com

ENVIRONMENT=development
# In produzione, l'indirizzo esatto della chat web (es. https://luce.vercel.app),
# per permettere solo a quel sito di chiamare le API del backend.
FRONTEND_ORIGIN=*
